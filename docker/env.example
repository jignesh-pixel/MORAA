# Copy to .env and fill in. NEVER commit the real .env.
PUBLIC_HOSTNAME=api.example.com

ENVIRONMENT=production
DATABASE_URL=postgresql://user:password@host:5432/postgres
SECRET_KEY=
RECHARGE_PAYMENT_URL=

META_APP_SECRET=
META_VERIFY_TOKEN=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
OPENAI_API_KEY=

CELERY_TASK_ALWAYS_EAGER=true
ADMIN_USERNAMES=
OPS_ALERT_WHATSAPP_NUMBERS=
SENTRY_DSN=
# Tune to the provider quota once known (0 = no limit):
MAX_CONCURRENT_PROVIDER_CALLS=0
IMAGE_PROVIDER_RPM=0
WEB_CONCURRENCY=2
